// BIRD SOUNDS
  <Sound y="130" sound="5730" isAmbient="true" loopCount="-1" volume="100" cx="264.93055555555554" cz="329.86111111111114" angle="315" />

  <Sound y="130" sound="snBirds" start="@bird1" isAmbient="true" loopCount="0" restart="true" volume="100" cx="264.93055555555554" cz="329.86111111111114" angle="315" />

  <Sound y="130" sound="snBirds" start="@bird2" isAmbient="true" loopCount="0" restart="true" volume="100" cx="264.93055555555554" cz="329.86111111111114" angle="315" />

  <Sound y="130" sound="snBirds" start="@bird3" isAmbient="true" loopCount="0" restart="true" volume="100" cx="264.93055555555554" cz="329.86111111111114" angle="315" />

<Timer in="@start" wait="100" out="@birds" />
<Timer in="@birds" wait="200" out="@bird1" />
<Timer in="@bird1" wait="random * 1100" out="@bird2" />
<Timer in="@bird2" wait="random * 1100" out="@bird3" />
<Timer in="@bird3" wait="random * 600" out="@birds" />



